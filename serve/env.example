# Inference service configuration.
#
# Copy to .env.serve and adjust, or export these directly. serve/start.sh reads
# them. The competition fixes the base image and the EDA toolchain but leaves the
# inference backend and service parameters to the team (topic guide 3.1.3.2), so
# every value that affects a reported result belongs here.

# Model the agent requests. Must match an entry in `ollama list`.
LOGICLENS_MODEL_NAME=qwen2.5-coder:1.5b

# Where the weights live. On the evaluation machine point this at a mounted
# volume rather than baking several GB into the image.
OLLAMA_MODELS=/models

# Address the agent talks to. The client appends /chat/completions.
LOGICLENS_MODEL_URL=http://127.0.0.1:11434/v1

# Sampling. run.sh and run_baseline.sh MUST use identical values, otherwise the
# reported gain is not attributable to the agent.
LOGICLENS_TEMPERATURE=0.2
LOGICLENS_TOP_P=0.95
LOGICLENS_MAX_TOKENS=2048

# Base seed. The agent offsets this per attempt (seed + attempt - 1) so a repair
# can differ from what it is fixing; a fixed seed alone makes the local server
# fully deterministic and every retry identical.
LOGICLENS_SEED=1

# Per-request timeout in seconds. The first request loads the model, which is
# much slower than subsequent ones.
LOGICLENS_TIMEOUT=300
LOGICLENS_RETRIES=2

# Path to vivado/vivado.bat when it is not on PATH. Usually unnecessary: the
# runner probes the standard install locations.
# LOGICLENS_VIVADO=/opt/Xilinx/2025.2/Vivado/bin/vivado
