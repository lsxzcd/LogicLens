__pycache__/
*.py[cod]
.venv/
.pylibs/
.tmp/
# Run artifacts. Keep experiments/dataset_*/ and experiments/*.py: those are
# fixtures and verification scripts the team shares.
experiments/runs/
experiments/results/
# The full VerilogEval export is ~470 KB and reproducible in one command:
#   py -3 tools/fetch_verilogeval_problem.py --all experiments/data/verilogeval
# Only a small representative set is vendored, so the parsing check and the
# end-to-end verification have something to run against without the whole set.
experiments/data/verilogeval/examples/*
!experiments/data/verilogeval/examples/Prob001_zero_*
!experiments/data/verilogeval/examples/Prob090_circuit1_*
!experiments/data/verilogeval/examples/Prob100_fsm3comb_*
!experiments/data/verilogeval/examples/Prob104_mt2015_muxdff_*
!experiments/data/verilogeval/examples/Prob120_fsm3s_*
!experiments/data/verilogeval/examples/Prob131_mt2015_q4_*
!experiments/data/verilogeval/examples/Prob156_review2015_fancytimer_*
*.jou
*.log
*.str
*.wdb
*.pb
.Xil/
xsim.dir/
# Written by Vivado into whatever directory it starts in, and by the DFX
# profiler; it is tool noise, not project output.
dfx_runtime.txt
hs_err_pid*.dmp
hs_err_pid*.log

